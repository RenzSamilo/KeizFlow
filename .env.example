# Copy to .env.local for local development. Never commit real values.
# Variable names may change once the web stack is chosen
# (for example a framework prefix for browser-visible values).

# Supabase project URL (dev locally and in previews, prod only in production)
SUPABASE_URL=

# Publishable key: safe in the browser and the app, protected by row-level security
SUPABASE_PUBLISHABLE_KEY=

# Secret key: server-side only. Never ship it in the web bundle or the Android app.
SUPABASE_SECRET_KEY=
